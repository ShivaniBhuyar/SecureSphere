# -----------------------------------------------------------------------------
# SecureSphere Root .gitignore
# -----------------------------------------------------------------------------

# --- Secrets, Environment & Configuration ---
*.env
.env
.env.*
!*.env.example
!**/.env.example

# --- Databases & Persistent Runtime Data ---
*.db
*.db-*
*.sqlite
*.sqlite3
securesphere.db
backend/securesphere.db

# --- Executables, Binaries & Tunnels ---
*.exe
*.dll
*.so
*.dylib
backend/cloudflared.exe

# --- Android Signing & Local Properties ---
local.properties
**/local.properties
key.properties
**/key.properties
*.keystore
**/*.keystore
*.jks
**/*.jks

# --- Python Backend (FastAPI, Pytest, venv) ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
env/
ENV/

# --- Logs, Diagnostics & Temp ---
*.log
**/*.log
.kotlin/
**/.kotlin/
*.tmp
*.bak

# --- Flutter / Dart Build & Dependency Artifacts ---
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
/build/
**/doc/api/
**/ios/Flutter/.last_build_id
**/Flutter/ephemeral/
/android/app/debug
/android/app/profile
/android/app/release

# --- Symbolication & Obfuscation ---
app.*.symbols
app.*.map.json

# --- IDE & Editor Settings ---
.idea/
*.iml
*.ipr
*.iws
.vscode/

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

