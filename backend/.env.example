# SecureSphere Backend Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Database configuration
# For PostgreSQL in Cloud/Docker:
# DATABASE_URL=postgresql://user:password@localhost:5432/securesphere
# Local development fallback (uses SQLite file if PostgreSQL not provided):
DATABASE_URL=sqlite:///./securesphere.db

# External Security Services (Stored strictly on backend - Never exposed to Flutter)
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_KEY=
PHISHTANK_API_KEY=
OPENAI_API_KEY=
